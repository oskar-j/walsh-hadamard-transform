# Controls what lands in the sdist. The wheel is driven by
# [tool.setuptools.packages.find] in pyproject.toml instead.
#
# setuptools picks up tests/test_*.py on its own but not conftest.py, which
# would ship a test suite whose fixtures are all undefined.

include CHANGELOG.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md
include requirements.txt requirements-demo.txt requirements-dev.txt
recursive-include tests *.py
recursive-include examples *.py

# The sample images are ~480 KB each and only feed tests that skip when the
# files are absent. Keep them out of the distribution. The whole folder, not a
# line per suffix: a list of suffixes was forgotten once already, when `.pkl`
# arrived in 0.4.15, and the samples now sit a folder deeper than it matched.
prune data
